<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- Le groupe `destructif` joue `demo:reset`, donc `migrate:fresh` : un DROP/CREATE de
         toutes les tables. Au milieu de la suite, il traverse les transactions ouvertes de
         RefreshDatabase et fait rougir des tests sans rapport (deadlock InnoDB 1213 observé
         sur l'activation d'invitation). Il est donc exclu ici et rejoué SEUL, en second
         passage, par `composer check` — couverture identique, sans la porte erratique.
         Le lancer à la main : `composer test-destructif`. -->
    <groups>
        <exclude>
            <group>destructif</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests sur MySQL/MariaDB (InnoDB), jamais SQLite : le moteur doit reproduire
             FOR UPDATE / verrous de ligne (sérialisation inscriptions, J2). SQLite ne
             verrouille pas à la ligne et fausserait ces tests.

             `force="false"` (le défaut) : la valeur ne s'applique QUE si l'environnement
             n'en fournit pas déjà une. La CI joue la suite sur les deux moteurs (matrice
             MySQL 8.4 = production OVH, et MariaDB 11.4) en passant DB_CONNECTION ; sans
             cette souplesse, la moitié de la matrice testerait le mauvais SGBD sans le
             dire. En local, sans variable, on reste sur mariadb. -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_DATABASE" value="cluboclock_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Client OAuth factice : la disponibilité de Google exige un client_id renseigné (§4.17,
             AuthMethodService::googleEnabled). Les tests de linking mockent Socialite et n'appellent
             jamais Google ; sans cette valeur, ils tomberaient sur le 404 « moyen indisponible ». -->
        <env name="GOOGLE_CLIENT_ID" value="test-client-id"/>
        <!-- La suite s'exécute comme une instance de CLUB, jamais comme une démo : le mode démo
             impose des garde-fous (mailer forcé, lien magique coupé §4.17) qui changeraient le
             comportement testé. Sans cette ligne, un DEMO_MODE=true laissé dans le .env du poste
             suffisait à faire échouer les tests d'authentification — en local seulement, la CI
             partant de .env.example. Les tests du mode démo activent le drapeau eux-mêmes. -->
        <env name="DEMO_MODE" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
