# =============================================================================
#  Club'O'Clock — configuration d'environnement
# =============================================================================
#  Copier ce fichier en .env puis renseigner les valeurs. Une instance par club
#  (pas de multi-tenant). Ne JAMAIS committer le .env : il contient des secrets.
#
#  Colonnes ci-dessous : [DEV] = poste local, [PROD] = déploiement OVH mutualisé.
# =============================================================================

APP_NAME="Club'O'Clock"

# Mode d'exécution. Valeurs conventionnelles : local | staging | production
#   - production : erreurs masquées, optimisations actives. [PROD] => production
#   - local      : poste de dev. [DEV] => local
#   (testing est réservé à PHPUnit ; ne pas l'utiliser en prod.)
APP_ENV=local

# Clé de chiffrement de l'app (sessions, cookies, données chiffrées).
# Générer UNE fois par instance : `php artisan key:generate` (remplit ce champ).
# [PROD] obligatoire, ne jamais réutiliser la clé d'un autre environnement.
APP_KEY=

# Affichage des erreurs détaillées (stack trace). [DEV] true — [PROD] false IMPÉRATIF
# (sinon une exception expose le code et des secrets au visiteur).
APP_DEBUG=true

# URL publique complète, avec le schéma. Sert à générer liens, redirections OAuth,
# assets. [DEV] http://localhost — [PROD] https://planning.mon-club.fr (HTTPS + domaine réel).
APP_URL=http://localhost

# Langue produit : français uniquement (pas d'i18n V1). Ne pas changer.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Compte admin amorcé (cadrage §7.3) : email repris par défaut par
# `php artisan club:create-admin`, la commande qui crée le tout premier admin.
# Il n'y a pas d'inscription publique — c'est le seul point d'entrée d'une base
# vide (cf. doc/INSTALL.md §4). Tout compte portant cet email est promu admin.
BOOTSTRAP_ADMIN_EMAIL=

# --- Google OAuth (optionnel) -----------------------------------------------
# Client propre au club (cf. doc/INSTALL.md). Vide = bouton « Se connecter avec
# Google » inopérant (l'email/mot de passe reste disponible). En [PROD], le
# redirect doit pointer sur l'URL HTTPS réelle et être déclaré côté Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logs -------------------------------------------------------------------
# [DEV] LOG_LEVEL=debug pour tout voir. [PROD] passer à LOG_LEVEL=warning (ou error)
# pour ne pas gonfler storage/logs sur le quota disque mutualisé.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (MariaDB/InnoDB) ---------------------------------------
# [PROD OVH] renseigner avec les identifiants du manager OVH (base mutualisée) :
#   DB_HOST = hôte fourni par OVH (souvent xxxxx.mysql.db ou similaire, PAS 127.0.0.1)
#   DB_DATABASE / DB_USERNAME = nom fourni par OVH ; DB_PASSWORD = celui défini au manager.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cluboclock
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions ---------------------------------------------------------------
# Stockées en base (pas de Redis sur mutualisé). [PROD] penser à SESSION_ENCRYPT=true
# et, sous HTTPS, laisser Laravel forcer le cookie secure via APP_URL en https.
SESSION_DRIVER=database
SESSION_TABLE=http_sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- File d'attente ---------------------------------------------------------
# IMPORTANT (mutualisé OVH) : PAS de worker permanent (queue:work) possible.
# Le traitement asynchrone passe par une tâche cron HORAIRE pointant `cron.php`
# (le mutualisé ne permet pas mieux, et la minute n'est pas choisissable) : elle
# lance une boucle qui appelle `schedule:run` chaque minute pendant ~55 min.
# Voir INSTALL §5.4. Laisser database (les jobs éventuels sont drainés par le
# scheduler), NE PAS mettre sync si un job long est ajouté un jour.
QUEUE_CONNECTION=database

# Cache en base (pas de Redis/Memcached sur mutualisé). Ne pas changer en [PROD].
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ------------------------------------------------------------------
# [DEV] MAIL_MAILER=log (les mails sont écrits dans storage/logs, rien n'est envoyé).
# [PROD] MAIL_MAILER=brevo + BREVO_API_KEY renseignée (voir plus bas). Régler aussi
# MAIL_FROM_ADDRESS sur une adresse du domaine (délivrabilité / SPF-DKIM).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Notifications (J8.6) ---------------------------------------------------
# Drivers d'envoi par canal. Vide OU absent = LogChannel (journalise + réussit,
# aucune dépendance externe : pratique en [DEV]) — le repli est fait par `?:` dans
# config/club.php, car une variable vide n'active PAS le défaut d'`env()`.
# Pour la livraison réelle en [PROD], pointer vers les vrais drivers :
#   NOTIF_PUSH_DRIVER='App\Notifications\Channels\PushChannel'
#   NOTIF_EMAIL_DRIVER='App\Notifications\Channels\EmailChannel'
NOTIF_PUSH_DRIVER=
NOTIF_EMAIL_DRIVER=

# Web Push VAPID — générer la paire via `php artisan club:vapid-keys`, coller ici.
# VAPID_PRIVATE_KEY = secret. VAPID_SUBJECT = contact imposé par la spec
# (mailto:admin@mon-club.fr ou une URL). Requis en [PROD] si push activé.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email transactionnel UE par API HTTP (Brevo par défaut, cadrage §6.3 ;
# Scaleway TEM / Mailjet = alternatives FR). [PROD] : MAIL_MAILER=brevo ci-dessus
# + coller la clé API Brevo ici. Scaleway TEM = bridge SMTP, voir doc/INSTALL.md.
BREVO_API_KEY=

# --- Mode démonstration (vitrine publique du projet) -------------------------
# ⚠️ NE JAMAIS activer sur l'instance d'un club réel.
# À true, l'écran de connexion AFFICHE les identifiants de démo : n'importe quel
# visiteur agit en admin. Le mode impose alors ses garde-fous — mailer forcé sur
# `log` et canaux de notification neutralisés, quoi que dise ce fichier — et
# déverrouille `php artisan demo:reset`, qui détruit la base chaque nuit.
# Voir doc/INSTALL.md §« Instance de démonstration ».
DEMO_MODE=false

# --- Stockage objet S3 (non utilisé en V1 : filesystem local hors webroot) ---
# Laisser vide sur OVH mutualisé.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
