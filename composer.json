{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stephanfo/club-o-clock",
    "type": "project",
    "description": "Club'O'Clock — Nage, pédale, cavale… fini le planning infernal ! PWA de planning d'entraînement pour club de triathlon (Laravel + Livewire). Une instance par club, pas de multi-tenant.",
    "keywords": ["laravel", "livewire", "pwa", "triathlon", "club-sportif", "planning"],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.8",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.8",
        "league/html-to-markdown": "^5.1",
        "livewire/livewire": "^3.0",
        "minishlink/web-push": "^10.1",
        "phpoffice/phpspreadsheet": "^5.8",
        "symfony/brevo-mailer": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan storage:link",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=1G vendor/bin/phpunit"
        ],
        "test-destructif": [
            "@php -d memory_limit=1G vendor/bin/phpunit --group=destructif"
        ],
        "check": [
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
            "@php artisan schema:check-drift",
            "@php artisan front:check-drift",
            "@test",
            "@test-destructif"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
